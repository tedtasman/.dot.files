#!/usr/bin/env bash
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

# check names are available
conflicts=()
for item in "$SCRIPT_DIR"/*; do
    # verify nonempty
    [ -d "$item" ] || continue 
    # strip to just item name
    name="${item##*/}" 
    if [ -f "$item/install" ]; then
        "$SCRIPT_DIR"/"$name"/install
    else 
        printf "$name has no install script\n"
    fi
done

